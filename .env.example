# Conexión a PostgreSQL (servicio local de desarrollo)
DATABASE_URL=postgres://postgres:12345@localhost:5432/lektor

# Secreto para invocar GET /api/cron/reservas.
# Si no está definido el endpoint responde 503 y no hace nada.
# Las reservas vencen igualmente por barrido diferido al servir tráfico.
# CRON_SECRET=cambia-esto-en-produccion

# Deja en 1 solo si la app está detrás de un proxy que reescriba las cabeceras de IP
# (Vercel, Cloudflare, Fly). Sin proxy, esas cabeceras las elige el cliente y los topes
# por IP se agrupan: todas las peticiones pasan a contar como una sola.
# TRUST_PROXY=1
